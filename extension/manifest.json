{
  "manifest_version": 3,
  "name": "Ferro",
  "version": "0.1.0",
  "description": "Chat with Ferro to work in one explicitly paired Chrome tab.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Ferro chat"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
