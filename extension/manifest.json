{
  "manifest_version": 3,
  "name": "Ferro",
  "version": "0.1.2",
  "description": "Chat with Ferro to work in one explicitly paired Chrome tab.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "debugger",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Ferro chat",
    "default_icon": {
      "16": "icons/ferro-16.png",
      "32": "icons/ferro-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/ferro-16.png",
    "48": "icons/ferro-48.png",
    "128": "icons/ferro-128.png"
  }
}
